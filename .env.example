# Riot API Key
# Get yours at https://developer.riotgames.com/
# Development keys last 24h, production keys require application
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your summoner info (used as default for analysis)
RIOT_SUMMONER_NAME=TonPseudo
RIOT_TAG_LINE=EUW
RIOT_REGION=europe
RIOT_PLATFORM=euw1

# LLM Provider (claude, openai, ollama, gemini, mistral)
LLM_PROVIDER=claude

# API Keys (set the one for your chosen provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
