<% content_for(:title, "LoL IA Coaching - Analyse tes replays avec l'IA") %>

<div class="w-full">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-[#c89b3c]/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-[#0ac8b9]/5 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 relative">
      <div class="text-center max-w-4xl mx-auto">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-[#12121a] border border-[#2a2a3a] rounded-full px-4 py-1.5 mb-8">
          <span class="w-2 h-2 rounded-full bg-[#0ac8b9] animate-pulse-cyan"></span>
          <span class="text-xs text-[#a09b8c] font-mono">12 detectors actifs</span>
        </div>

        <!-- Main heading -->
        <h1 class="text-5xl sm:text-7xl font-black tracking-tight mb-6">
          <span class="text-[#f0e6d2]">Analyse tes replays</span>
          <br>
          <span class="text-gradient-gold">LoL avec l'IA</span>
        </h1>

        <p class="text-lg sm:text-xl text-[#a09b8c] max-w-2xl mx-auto mb-10 leading-relaxed">
          Upload ton Match ID, notre pipeline extrait chaque detail de ta game
          et Claude te genere un coaching personnalise.
        </p>

        <!-- Login Form -->
        <form action="/auth/riot/callback" method="get"
              class="flex flex-col sm:flex-row gap-3 justify-center items-center max-w-lg mx-auto">
          <div class="flex items-center bg-[#12121a] border border-[#2a2a3a] rounded-xl overflow-hidden focus-within:border-[#c89b3c]/50 transition-colors w-full sm:w-auto">
            <input type="text" name="name" placeholder="Riot Name" required
                   class="bg-transparent px-4 py-3 text-[#f0e6d2] placeholder-[#a09b8c]/40 focus:outline-none w-full sm:w-44 text-sm">
            <span class="text-[#a09b8c]/30 text-lg font-light">#</span>
            <input type="text" name="tag" placeholder="EUW" required
                   class="bg-transparent px-3 py-3 text-[#f0e6d2] placeholder-[#a09b8c]/40 focus:outline-none w-20 text-sm">
          </div>
          <button type="submit"
                  class="btn-gold px-8 py-3 rounded-xl text-sm inline-flex items-center gap-2 group whitespace-nowrap">
            Commencer
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Feature Cards -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Card 1: Positions -->
      <div class="bg-card rounded-2xl p-8 transition-all duration-300 group">
        <div class="w-12 h-12 rounded-xl bg-[#0ac8b9]/10 flex items-center justify-center mb-6 group-hover:bg-[#0ac8b9]/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#0ac8b9]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-[#f0e6d2] mb-3">Positions seconde par seconde</h3>
        <p class="text-[#a09b8c] text-sm leading-relaxed">
          Extraction des positions de tous les joueurs via Riot API timeline + Frida memory scan.
          Visualisation sur la minimap interactive.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="text-xs font-mono bg-[#0ac8b9]/10 text-[#0ac8b9] px-2 py-1 rounded">Timeline API</span>
          <span class="text-xs font-mono bg-[#0ac8b9]/10 text-[#0ac8b9] px-2 py-1 rounded">Frida</span>
          <span class="text-xs font-mono bg-[#0ac8b9]/10 text-[#0ac8b9] px-2 py-1 rounded">Minimap</span>
        </div>
      </div>

      <!-- Card 2: 12 Detectors -->
      <div class="bg-card rounded-2xl p-8 transition-all duration-300 group">
        <div class="w-12 h-12 rounded-xl bg-[#c89b3c]/10 flex items-center justify-center mb-6 group-hover:bg-[#c89b3c]/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#c89b3c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-[#f0e6d2] mb-3">12 detectors</h3>
        <p class="text-[#a09b8c] text-sm leading-relaxed">
          Deaths, CS, roams, teamfights, objectifs, wards, item spikes, lane state, comeback...
          Chaque aspect de ta game est analyse.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="text-xs font-mono bg-[#c89b3c]/10 text-[#c89b3c] px-2 py-1 rounded">Death</span>
          <span class="text-xs font-mono bg-[#c89b3c]/10 text-[#c89b3c] px-2 py-1 rounded">CS</span>
          <span class="text-xs font-mono bg-[#c89b3c]/10 text-[#c89b3c] px-2 py-1 rounded">Teamfight</span>
          <span class="text-xs font-mono bg-[#c89b3c]/10 text-[#c89b3c] px-2 py-1 rounded">+9</span>
        </div>
      </div>

      <!-- Card 3: Review IA -->
      <div class="bg-card rounded-2xl p-8 transition-all duration-300 group">
        <div class="w-12 h-12 rounded-xl bg-[#c89b3c]/10 flex items-center justify-center mb-6 group-hover:bg-[#c89b3c]/20 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#c89b3c]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-[#f0e6d2] mb-3">Review coaching IA</h3>
        <p class="text-[#a09b8c] text-sm leading-relaxed">
          Claude analyse tes patterns, identifie tes erreurs recurrentes et te donne
          3 axes de progression concrets pour chaque game.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="text-xs font-mono bg-[#c89b3c]/10 text-[#c89b3c] px-2 py-1 rounded">Claude</span>
          <span class="text-xs font-mono bg-[#c89b3c]/10 text-[#c89b3c] px-2 py-1 rounded">Coaching</span>
          <span class="text-xs font-mono bg-[#c89b3c]/10 text-[#c89b3c] px-2 py-1 rounded">Progression</span>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-t border-[#2a2a3a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <h2 class="text-2xl font-bold text-[#f0e6d2] text-center mb-12">Comment ca marche</h2>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-10 h-10 rounded-full bg-[#c89b3c]/20 text-[#c89b3c] font-bold flex items-center justify-center mx-auto mb-4 font-mono">1</div>
          <p class="text-sm text-[#a09b8c]">Entre ton <span class="text-[#f0e6d2] font-semibold">Match ID</span> ou upload ton fichier .rofl</p>
        </div>
        <div class="text-center">
          <div class="w-10 h-10 rounded-full bg-[#c89b3c]/20 text-[#c89b3c] font-bold flex items-center justify-center mx-auto mb-4 font-mono">2</div>
          <p class="text-sm text-[#a09b8c]">Notre pipeline extrait <span class="text-[#f0e6d2] font-semibold">75+ events</span> de ta game</p>
        </div>
        <div class="text-center">
          <div class="w-10 h-10 rounded-full bg-[#c89b3c]/20 text-[#c89b3c] font-bold flex items-center justify-center mx-auto mb-4 font-mono">3</div>
          <p class="text-sm text-[#a09b8c]"><span class="text-[#f0e6d2] font-semibold">Claude</span> analyse tes patterns et erreurs</p>
        </div>
        <div class="text-center">
          <div class="w-10 h-10 rounded-full bg-[#c89b3c]/20 text-[#c89b3c] font-bold flex items-center justify-center mx-auto mb-4 font-mono">4</div>
          <p class="text-sm text-[#a09b8c]">Recois ta <span class="text-[#f0e6d2] font-semibold">review coaching</span> personnalisee</p>
        </div>
      </div>
    </div>
  </section>
</div>
