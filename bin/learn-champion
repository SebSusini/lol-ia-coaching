#!/usr/bin/env bash
set -euo pipefail

# Generates champion knowledge for the coaching prompt
# Uses LLM API to fill the template if a key is configured in .env
#
# Usage: bin/learn-champion Gwen jungle
#        bin/learn-champion Sylas mid
#        bin/learn-champion "Bel'Veth" jungle --force

CHAMPION="${1:-}"
ROLE="${2:-}"
FORCE=false

# Parse optional flags after positional args
for arg in "$@"; do
    case "$arg" in
        --force|-f) FORCE=true ;;
    esac
done

if [ -z "$CHAMPION" ] || [ -z "$ROLE" ]; then
    echo "Usage: bin/learn-champion <champion> <role>"
    echo ""
    echo "Examples:"
    echo "  bin/learn-champion Gwen jungle"
    echo "  bin/learn-champion Sylas mid"
    echo "  bin/learn-champion Ahri mid --force   # overwrite existing"
    echo ""
    echo "If an LLM API key is configured in .env, the template will be"
    echo "auto-filled with champion knowledge. Otherwise, a blank template"
    echo "is created for you to fill manually."
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Load .env
if [ -f "$SCRIPT_DIR/.env" ]; then
    export $(grep -v '^#' "$SCRIPT_DIR/.env" | grep -v '^$' | xargs)
fi

CHAMPION_LOWER=$(echo "$CHAMPION" | tr '[:upper:]' '[:lower:]' | sed "s/'//g" | sed 's/ //g')
ROLE_LOWER=$(echo "$ROLE" | tr '[:upper:]' '[:lower:]')
OUTPUT_FILE="$SCRIPT_DIR/prompts/champions/${CHAMPION_LOWER}_${ROLE_LOWER}.md"

if [ -f "$OUTPUT_FILE" ] && [ "$FORCE" != "true" ]; then
    echo "Le fichier $OUTPUT_FILE existe deja."
    read -p "Ecraser ? (y/n) " CONFIRM
    if [ "$CONFIRM" != "y" ]; then exit 0; fi
fi

echo "Generation des connaissances pour $CHAMPION $ROLE..."

# Generate content using Ruby (handles LLM calls if API key present)
CONTENT=$(ruby -e "
\$LOAD_PATH.unshift(File.join('$SCRIPT_DIR', 'extractor', 'lib'))
require 'champion_knowledge_generator'

generator = ChampionKnowledgeGenerator.new('$CHAMPION', '$ROLE_LOWER')

begin
  content = generator.generate
  print content
rescue => e
  \$stderr.puts \"  Error: #{e.message}\"
  \$stderr.puts \"  Falling back to template...\"
  # Re-create generator and get template only
  print ChampionKnowledgeGenerator.new('$CHAMPION', '$ROLE_LOWER').send(:generate_template)
end
" 2>&1)

# Write to file
echo "$CONTENT" > "$OUTPUT_FILE"

echo ""
echo "Champion knowledge saved: $OUTPUT_FILE"
echo ""

# Check if it was auto-filled or just a template
if echo "$CONTENT" | grep -q "\[TODO\]"; then
    echo "Le fichier contient des [TODO] a remplir."
    echo ""
    echo "Pas de cle API LLM detectee. Pour auto-remplir, ajoute dans .env :"
    echo "  ANTHROPIC_API_KEY=sk-ant-..."
    echo "  # ou OPENAI_API_KEY=sk-..."
    echo "  # ou GEMINI_API_KEY=..."
    echo ""
    echo "Sinon, remplis manuellement ou demande a Claude Code :"
    echo "  'Remplis prompts/champions/${CHAMPION_LOWER}_${ROLE_LOWER}.md'"
else
    echo "Contenu genere automatiquement via LLM."
    echo "Verifie le contenu et ajuste si necessaire."
fi

echo ""
echo "Les prochaines reviews de $CHAMPION $ROLE utiliseront ces connaissances automatiquement."
